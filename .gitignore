tmp/
temp/
.tmp/
.temp/

**/tmp/
**/temp/

*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~


# ============================================================
# Application Generated Output
# ============================================================

output/
outputs/
generated/
reports/

**/output/
**/outputs/
**/generated/


# ============================================================
# Downloads
# ============================================================

downloads/
download/

**/downloads/


# ============================================================
# Excel temporary / lock files
# ============================================================

~$*.xlsx
~$*.xls
~$*.xlsm
~$*.xlsb
~$*.csv


# ============================================================
# Microsoft Office temporary files
# ============================================================

~$*.doc
~$*.docx
~$*.ppt
~$*.pptx


# ============================================================
# CSV / Excel Output
#
# IMPORTANT:
# Do NOT ignore all xlsx/csv files by default because they may
# be required as application input files.
# ============================================================

# Uncomment if ALL Excel/CSV files should be excluded:
# *.xlsx
# *.xls
# *.xlsm
# *.csv


# ============================================================
# PDF generated output
# ============================================================

# Uncomment only if PDFs are generated files
# *.pdf


